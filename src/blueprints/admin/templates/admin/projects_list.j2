<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Админка - Проекты</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-light">
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <!-- КНОПКА ВОЗВРАТА В ГЛАВНУЮ АДМИНКУ -->
                <a href="{{ url_for('admin.index') }}" class="btn btn-outline-light">← В главную админку</a>
                <h1 class="mb-0">Список проектов</h1>
            </div>
            <a href="{{ url_for('admin.edit_project') }}" class="btn btn-success">+ Новый проект</a>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Превью</th>
                        <th>Название</th>
                        <th>Статус</th>
                        <th>Галерея</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    {% for project in projects %}
                    <tr>
                        <td>{{ project.id }}</td>
                        <td>
                            {% if project.preview_image %}
                                {% if project.preview_image.startswith('http') %}
                                    <img src="{{ project.preview_image }}" width="60" class="rounded">
                                {% else %}
                                    <img src="{{ url_for('uploaded_file', filename=project.preview_image.replace('uploads/', '').replace('static/', '')) }}"
                                         width="60" class="rounded">
                                {% endif %}
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td>{{ project.title_ru[:50] }}{% if project.title_ru|length > 50 %}...{% endif %}</td>
                        <td>
                            {% if project.is_published %}
                                <span class="badge bg-success">Опубликован</span>
                            {% else %}
                                <span class="badge bg-warning">Черновик</span>
                            {% endif %}
                        </td>
                        <td>{{ project.gallery_images|length }}/15</td>
                        <td class="text-end">
                            <a href="{{ url_for('admin.edit_project', id=project.id) }}"
                               class="btn btn-sm btn-primary me-1">Редактировать</a>
                            <a href="{{ url_for('admin.delete_project', id=project.id) }}"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Удалить проект?')">Удалить</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
