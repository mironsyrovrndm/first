<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if project.id %}Редактировать{% else %}Новый{% endif %} проект</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #121212; color: #e0e0e0; }
        .card { background-color: #1e1e1e; border: 1px solid #333; }
        .card-header { border-bottom: 1px solid #333; background-color: #252525; }
        .form-control, .form-control:focus {
            background-color: #2d2d2d; border-color: #444; color: #fff;
        }
        .form-text { color: #888; }

        /* Стили для галереи */
        .gallery-grid-admin {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }
        .gallery-item-admin {
            position: relative;
            aspect-ratio: 1;
            border: 1px solid #444;
            border-radius: 8px;
            overflow: hidden;
            background: #000;
        }
        .gallery-item-admin img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .btn-delete-img {
            position: absolute;
            top: 5px; right: 5px;
            background: rgba(220, 53, 69, 0.9);
            color: white;
            border: none;
            width: 24px; height: 24px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer;
            font-size: 14px;
            line-height: 1;
            transition: 0.2s;
            text-decoration: none;
        }
        .btn-delete-img:hover {
            background: #ff0000;
            transform: scale(1.1);
        }
    </style>
</head>
<body>
    <div class="container mt-5 mb-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>{% if project.id %}Редактирование проекта{% else %}Новый проект{% endif %}</h2>

            <div>
                {% if project.id %}
                <a href="{{ url_for('main.project_detail', lang='ru', id=project.id) }}" target="_blank" class="btn btn-outline-info me-2">👀 Посмотреть на сайте</a>
                {% endif %}
                <a href="{{ url_for('admin.projects_list') }}" class="btn btn-secondary">← Назад к списку</a>
            </div>
        </div>

        <form method="POST" enctype="multipart/form-data">

            <div class="row">
                <!-- ЛЕВАЯ КОЛОНКА: Превью и Инфо -->
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header fw-bold">📱 Превью (для главной)</div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Название</label>
                                <input type="text" name="title_ru" class="form-control" value="{{ project.title_ru or '' }}" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Краткое описание</label>
                                <textarea name="short_desc_ru" class="form-control" rows="3">{{ project.short_desc_ru or '' }}</textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Картинка-превью</label>
                                <input type="file" name="preview_image" class="form-control" accept="image/*">
                                {% if project.preview_image %}
                                    <div class="mt-3">
                                        {% if project.preview_image.startswith('http') %}
                                            <img src="{{ project.preview_image }}" class="rounded border" style="max-width: 100%; max-height: 200px;">
                                        {% else %}
                                            <!-- ИСПРАВЛЕНО: используется uploaded_file и очистка путей -->
                                            <img src="{{ url_for('uploaded_file', filename=project.preview_image.replace('uploads/', '').replace('static/', '')) }}"
                                                 class="rounded border" style="max-width: 100%; max-height: 200px;">
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ПРАВАЯ КОЛОНКА: Контент -->
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header fw-bold">📝 Контент страницы</div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Полное описание</label>
                                <textarea name="full_desc_ru" class="form-control" rows="8">{{ project.full_desc_ru or '' }}</textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Видео (YouTube / RuTube)</label>
                                <input type="url" name="video_url" class="form-control" value="{{ project.video_url or '' }}" placeholder="https://...">
                            </div>

                            <div class="row">
                                <div class="col-6">
                                    <label class="form-label">Порядок</label>
                                    <input type="number" name="order" class="form-control" value="{{ project.order_num or 0 }}">
                                </div>
                                <div class="col-6 d-flex align-items-end">
                                    <div class="form-check mb-2">
                                        <input type="checkbox" name="is_published" class="form-check-input" id="pub" {% if project.is_published %}checked{% endif %}>
                                        <label class="form-check-label" for="pub">Опубликовать</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- НИЖНИЙ БЛОК: ГАЛЕРЕЯ -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold">🖼️ Галерея проекта</span>
                    <span class="badge bg-secondary">{{ project.gallery_images|length }}/15</span>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Добавить фото (можно выбрать несколько)</label>
                        <input type="file" name="gallery_images" class="form-control" multiple accept="image/*">
                    </div>

                    {% if project.gallery_images %}
                    <div class="gallery-grid-admin">
                        {% for img in project.gallery_images %}
                        <div class="gallery-item-admin">
                            {% if img.image_filename.startswith('http') %}
                                <img src="{{ img.image_filename }}">
                            {% else %}
                                <!-- ИСПРАВЛЕНО: используется uploaded_file и очистка путей -->
                                <img src="{{ url_for('uploaded_file', filename=img.image_filename.replace('uploads/', '').replace('static/', '')) }}">
                            {% endif %}

                            <a href="{{ url_for('admin.delete_gallery_image', img_id=img.id) }}"
                               class="btn-delete-img"
                               title="Удалить фото"
                               onclick="return confirm('Удалить это фото?')">×</a>
                        </div>
                        {% endfor %}
                    </div>
                    {% else %}
                        <div class="text-center text-muted py-4">Нет загруженных фото</div>
                    {% endif %}
                </div>
            </div>

            <!-- КНОПКИ СОХРАНЕНИЯ -->
            <div class="d-grid gap-2 d-md-flex justify-content-md-start pb-5">
                <button type="submit" class="btn btn-success btn-lg px-5">💾 Сохранить изменения</button>
                <a href="{{ url_for('admin.projects_list') }}" class="btn btn-outline-secondary btn-lg">Отмена</a>
            </div>

        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
