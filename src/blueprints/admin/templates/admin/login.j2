<!DOCTYPE html>
<html>
<head><title>Login</title></head>
<body style="font-family: sans-serif; display:flex; justify-content:center; padding-top:50px;">
    <form method="POST" style="border:1px solid #ccc; padding:20px; border-radius:8px;">
        <h2>Вход в админку</h2>
        {% with messages = get_flashed_messages() %}
            {% if messages %}<div style="color:red">{{ messages[0] }}</div>{% endif %}
        {% endwith %}
        <p><input type="text" name="username" placeholder="Username" required></p>
        <p><input type="password" name="password" placeholder="Password" required></p>
        <p><button type="submit">Войти</button></p>
    </form>
</body>
</html>
