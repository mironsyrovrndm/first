<!DOCTYPE html>
<html>
<head>
    <title>Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container">
            <span class="navbar-brand mb-0 h1">Portfolio Admin</span>
            <a href="{{ url_for('admin.logout') }}" class="btn btn-outline-light btn-sm">Выйти</a>
        </div>
    </nav>

    <div class="container">
        {% with messages = get_flashed_messages(with_categories=true) %}
          {% if messages %}
            {% for category, message in messages %}
              <div class="alert alert-{{ category }}">{{ message }}</div>
            {% endfor %}
          {% endif %}
        {% endwith %}

        <!-- Profile Section -->
        <div class="card mb-4">
            <div class="card-header"><h3>Основной профиль</h3></div>
            <div class="card-body">
                <form method="POST" enctype="multipart/form-data">
                    {{ profile_form.hidden_tag() }}

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ profile_form.full_name.label(class="form-label") }}
                            {{ profile_form.full_name(class="form-control") }}
                        </div>

                        <!-- Поле загрузки фото -->
                        <div class="col-md-6 mb-3">
                            {{ profile_form.photo.label(class="form-label") }}
                            {{ profile_form.photo(class="form-control") }}

                            <!-- Превью текущего фото -->
                            {% if profile and profile.photo_url %}
                                <div class="mt-2">
                                    <small class="text-muted">Текущее фото:</small><br>
                                    {% if profile.photo_url.startswith('http') %}
                                        <img src="{{ profile.photo_url }}" height="60" class="rounded border">
                                    {% else %}
                                        <img src="{{ url_for('uploaded_file', filename=profile.photo_url.replace('static/', '').replace('uploads/', '')) }}" height="60" class="rounded border">
                                    {% endif %}
                                </div>
                            {% endif %}

                            {% if profile_form.photo.errors %}
                                <div class="text-danger">
                                    {% for error in profile_form.photo.errors %}
                                        <small>{{ error }}</small>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="col-12 mb-3">
                            {{ profile_form.intro_text.label(class="form-label") }}
                            {{ profile_form.intro_text(class="form-control", rows=3) }}
                        </div>
                        <div class="col-12 mb-3">
                            {{ profile_form.specialization.label(class="form-label") }}
                            {{ profile_form.specialization(class="form-control", rows=3) }}
                        </div>

                        <div class="col-md-6 mb-3">
                            {{ profile_form.education.label(class="form-label") }}
                            {{ profile_form.education(class="form-control", rows=5) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ profile_form.looking_for.label(class="form-label") }}
                            {{ profile_form.looking_for(class="form-control", rows=5) }}
                        </div>
                    </div>

                    <hr class="my-4">
                    <h5 class="mb-3">Настройка заголовков навыков</h5>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            {{ profile_form.skill_title_design.label(class="form-label") }}
                            {{ profile_form.skill_title_design(class="form-control") }}
                        </div>
                        <div class="col-md-4 mb-3">
                            {{ profile_form.skill_title_video.label(class="form-label") }}
                            {{ profile_form.skill_title_video(class="form-control") }}
                        </div>
                        <div class="col-md-4 mb-3">
                            {{ profile_form.skill_title_soft.label(class="form-label") }}
                            {{ profile_form.skill_title_soft(class="form-control") }}
                        </div>
                    </div>

                    <button type="submit" name="submit_profile" class="btn btn-primary">Сохранить профиль</button>
                </form>
            </div>
        </div>

        <!-- Skills -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3>Навыки</h3>
                <a href="{{ url_for('admin.add_skill') }}" class="btn btn-success btn-sm">+ Добавить</a>
            </div>
            <div class="card-body">
                <table class="table">
                    <thead><tr><th>Категория</th><th>Название</th><th>Уровень</th><th>Действия</th></tr></thead>
                    <tbody>
                    {% for s in skills %}
                        <tr>
                            <td>{{ s.category }}</td>
                            <td>{{ s.name }}</td>
                            <td>{{ s.level }}</td>
                            <td>
                                <!-- ДОБАВЛЕНО: Кнопка изменить -->
                                <a href="{{ url_for('admin.edit_skill', id=s.id) }}" class="btn btn-sm btn-outline-primary me-1">Изменить</a>
                                <a href="{{ url_for('admin.delete_skill', id=s.id) }}" class="text-danger" onclick="return confirm('Удалить?')">Удалить</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Experience -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3>Опыт работы</h3>
                <a href="{{ url_for('admin.add_experience') }}" class="btn btn-success btn-sm">+ Добавить</a>
            </div>
            <div class="card-body">
                <ul class="list-group">
                    {% for e in experience %}
                        <li class="list-group-item d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-bold">{{ e.title }}</div>
                                {{ e.period }}
                            </div>
                            <div>
                                <!-- ДОБАВЛЕНО: Кнопка изменить -->
                                <a href="{{ url_for('admin.edit_experience', id=e.id) }}" class="btn btn-sm btn-outline-primary me-1">Изменить</a>
                                <a href="{{ url_for('admin.delete_experience', id=e.id) }}" class="btn-close" onclick="return confirm('Удалить?')"></a>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        <!-- Contacts -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3>Контакты</h3>
                <a href="{{ url_for('admin.add_contact') }}" class="btn btn-success btn-sm">+ Добавить</a>
            </div>
            <div class="card-body">
                <table class="table">
                    {% for c in contacts %}
                    <tr>
                        <td>{{ c.network_name }}</td>
                        <td>{{ c.display_text }}</td>
                        <td>
                            <!-- ДОБАВЛЕНО: Кнопка изменить -->
                            <a href="{{ url_for('admin.edit_contact', id=c.id) }}" class="btn btn-sm btn-outline-primary me-1">Изменить</a>
                            <a href="{{ url_for('admin.delete_contact', id=c.id) }}" class="text-danger" onclick="return confirm('Удалить?')">X</a>
                        </td>
                    </tr>
                    {% endfor %}
                </table>
            </div>
        </div>

        <!-- === БЛОК ПРОЕКТОВ === -->
        <div class="card mb-4 bg-light border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h3 class="mb-0">Проекты</h3>
                <a href="{{ url_for('admin.edit_project') }}" class="btn btn-light btn-sm text-primary fw-bold">+ Создать проект</a>
            </div>
            <div class="card-body">
                {% if projects %}
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;">Превью</th>
                            <th>Название</th>
                            <th style="width: 100px;">Статус</th>
                            <th style="width: 80px;">Порядок</th>
                            <th style="width: 180px;" class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for project in projects %}
                        <tr>
                            <td>
                                {% if project.preview_image %}
                                    {% if project.preview_image.startswith('http') %}
                                        <img src="{{ project.preview_image }}"
                                             class="rounded border"
                                             style="width: 60px; height: 40px; object-fit: cover;">
                                    {% else %}
                                        <img src="{{ url_for('uploaded_file', filename=project.preview_image.replace('uploads/', '').replace('static/', '')) }}"
                                             class="rounded border"
                                             style="width: 60px; height: 40px; object-fit: cover;">
                                    {% endif %}
                                {% else %}
                                    <span class="text-muted" style="font-size: 0.8em;">Нет фото</span>
                                {% endif %}
                            </td>
                            <td>
                                <strong>{{ project.title_ru }}</strong><br>
                                <small class="text-muted">{{ project.title_en }}</small>
                            </td>
                            <td>
                                {% if project.is_published %}
                                    <span class="badge bg-success">Опубликован</span>
                                {% else %}
                                    <span class="badge bg-secondary">Черновик</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">{{ project.order_num }}</span>
                            </td>
                            <td class="text-end">
                                <a href="{{ url_for('main.project_detail', lang='ru', id=project.id) }}"
                                   target="_blank"
                                   class="btn btn-sm btn-outline-dark me-1"
                                   title="Открыть на сайте">↗</a>

                                <a href="{{ url_for('admin.edit_project', id=project.id) }}" class="btn btn-sm btn-outline-primary me-1">Изменить</a>
                                <a href="{{ url_for('admin.delete_project', id=project.id) }}"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Удалить проект «{{ project.title_ru }}»?')">×</a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% else %}
                    <p class="text-muted text-center my-3">Проектов пока нет. Нажмите "Создать проект", чтобы добавить первый.</p>
                {% endif %}
            </div>
        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
